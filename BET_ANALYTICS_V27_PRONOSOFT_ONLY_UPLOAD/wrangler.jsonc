{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bet-analytics",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
